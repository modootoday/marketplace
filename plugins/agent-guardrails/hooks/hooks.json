{
  "description": "Refuse shell commands whose damage is hard to undo.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
