{
  "description": "Cap the concurrency of heavy build and test commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
